<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Scanner — PIGVS</title>

    <link rel="stylesheet" href="style.css" />
    <link rel="manifest" href="manifest.json" />
    <meta name="theme-color" content="#0B2C5C" />
    <link rel="apple-touch-icon" href="icon-192.png" />

    <style>
      .scan-zone {
        text-align: center;
        padding: 26px 16px 20px;
      }

      .ico-barcode {
        width: 76px;
        height: 76px;
        display: block;
        margin: 0 auto 10px;
        fill: var(--marine);
      }

      .ico-barcode-btn {
        width: 26px;
        height: 26px;
        fill: #fff;
        flex: 0 0 auto;
      }

      .scan-zone h2 {
        margin: 0 0 6px;
        font-size: 20px;
        color: var(--marine);
      }

      .scan-zone p {
        margin: 0 0 18px;
        font-size: 14px;
        color: var(--muted);
      }

      .btn-scan {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: 100%;
        min-height: 62px;
        font-size: 18px;
        font-weight: 700;
        color: #fff;
        background: var(--primary);
        border: 0;
        border-radius: 14px;
        cursor: pointer;
        box-shadow: 0 3px 12px rgba(0, 120, 215, 0.3);
      }

      .btn-scan:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .separateur {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 20px 0 14px;
        color: var(--muted);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
      }

      .separateur::before,
      .separateur::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--border);
      }

      .saisie-manuelle {
        display: flex;
        gap: 8px;
      }

      .saisie-manuelle input {
        flex: 1;
      }

      .saisie-manuelle button {
        flex: 0 0 auto;
        padding: 0 18px;
        font-weight: 700;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: #eef1f6;
        cursor: pointer;
      }

      .resultat {
        background: #fff;
        border: 1px solid var(--border);
        border-top: 5px solid var(--acc, var(--primary));
        border-radius: var(--radius);
        box-shadow: var(--shadow-lg);
        padding: 18px 16px;
        margin-top: 18px;
      }

      .resultat .type {
        display: inline-block;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: var(--acc, var(--primary));
        margin-bottom: 6px;
      }

      .resultat h3 {
        margin: 0 0 4px;
        font-size: 19px;
        color: var(--marine);
      }

      .resultat .code-lu {
        font-family: monospace;
        font-size: 13px;
        color: var(--muted);
        background: #f4f7fb;
        border-radius: 8px;
        padding: 6px 10px;
        display: inline-block;
        margin-bottom: 14px;
      }

      .actions-resultat {
        display: flex;
        flex-direction: column;
        gap: 9px;
      }

      .actions-resultat a,
      .actions-resultat button {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        min-height: 54px;
        padding: 13px 16px;
        font-size: 15.5px;
        font-weight: 700;
        text-decoration: none;
        color: var(--text);
        background: #fff;
        border: 1px solid #ccd4e0;
        border-radius: 12px;
        cursor: pointer;
        text-align: left;
      }

      .actions-resultat .principal {
        background: var(--primary);
        border-color: var(--primary);
        color: #fff;
      }

      .actions-resultat .principal .fl {
        color: #fff;
      }

      .actions-resultat .indispo {
        opacity: 0.5;
        pointer-events: none;
      }

      .actions-resultat .fl {
        color: var(--primary);
        font-size: 18px;
      }

      /* ---------- Contenu de la caisse ---------- */
      .bloc-contenu {
        margin-top: 16px;
        border-top: 1px solid #eef0f3;
        padding-top: 12px;
      }

      .bloc-contenu .entete {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 8px;
        flex-wrap: wrap;
      }

      .bloc-contenu .compte {
        background: var(--primary-soft);
        color: var(--marine);
        border-radius: 999px;
        padding: 3px 10px;
        font-weight: 700;
        font-size: 12.5px;
      }

      .liste-contenu {
        list-style: none;
        padding: 0;
        margin: 0;
        max-height: 420px;
        overflow-y: auto;
      }

      .liste-contenu li {
        padding: 10px 12px;
        border-bottom: 1px solid #eef0f3;
        font-size: 14.5px;
        display: flex;
        gap: 9px;
        align-items: flex-start;
      }

      .liste-contenu li::before {
        content: "🔧";
        flex: 0 0 auto;
      }

      .liste-contenu li:last-child {
        border-bottom: 0;
      }

      .alerte-scan {
        background: #fff8e1;
        border: 1px solid #ffe0a3;
        color: #8a6100;
        border-radius: 10px;
        padding: 11px 13px;
        font-size: 13.5px;
        margin-top: 14px;
      }
    </style>

    <script src="pigvs-auth.js"></script>
    <script>
      PIGVS_AUTH.protegerPage();
    </script>
  </head>

  <body>
    <header class="app-header">
      <a class="back" href="index.html">‹</a>
      <h1>Scanner</h1>
    </header>

    <div class="page">
      <div class="scan-zone">
        <svg class="ico-barcode" viewBox="0 0 64 64" role="img" aria-label="Code-barres">
          <rect x="4"  y="14" width="4"  height="36" rx="1" />
          <rect x="12" y="14" width="2"  height="36" rx="1" />
          <rect x="18" y="14" width="5"  height="36" rx="1" />
          <rect x="27" y="14" width="2"  height="36" rx="1" />
          <rect x="33" y="14" width="4"  height="36" rx="1" />
          <rect x="41" y="14" width="2"  height="36" rx="1" />
          <rect x="47" y="14" width="5"  height="36" rx="1" />
          <rect x="56" y="14" width="4"  height="36" rx="1" />
        </svg>
        <h2>Scanner un code</h2>
        <p>
          Code-barres ou QR code d'une caisse, d'un conteneur ou d'un
          équipement.
        </p>

        <button type="button" class="btn-scan" id="btnScan">
          <svg class="ico-barcode-btn" viewBox="0 0 64 64" aria-hidden="true">
            <rect x="4"  y="14" width="4"  height="36" rx="1" />
            <rect x="12" y="14" width="2"  height="36" rx="1" />
            <rect x="18" y="14" width="5"  height="36" rx="1" />
            <rect x="27" y="14" width="2"  height="36" rx="1" />
            <rect x="33" y="14" width="4"  height="36" rx="1" />
            <rect x="41" y="14" width="2"  height="36" rx="1" />
            <rect x="47" y="14" width="5"  height="36" rx="1" />
            <rect x="56" y="14" width="4"  height="36" rx="1" />
          </svg>
          <span>Ouvrir le scanner</span>
        </button>

        <div class="separateur">ou</div>

        <div class="saisie-manuelle">
          <input
            type="text"
            id="codeManuel"
            placeholder="Saisir le code manuellement"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
          />
          <button type="button" id="btnValiderCode">OK</button>
        </div>

        <div class="alerte-scan" id="alerteScan" style="display: none"></div>
      </div>

      <div id="resultat"></div>
    </div>

    <script src="pigvs-scan.js"></script>
    <script src="pigvs-chantier.js"></script>
    <script src="pigvs-colisage.js"></script>
<script>
      let CODES = {};
      let COLISAGE = { conteneurs: [] };

      const zoneResultat = document.getElementById("resultat");
      const alerteScan = document.getElementById("alerteScan");

      /* =========================================================
         NORMALISATION TOLÉRANTE
         « BOX #40 », « BOX 40 », « Box40 » -> « box40 »
         C'est ce qui permet de retrouver la caisse dans
         colisage-data.json même si l'écriture diffère un peu.
         ========================================================= */
      function norm(s) {
        return (s || "")
          .toString()
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/\s+/g, " ")
          .trim();
      }

      function cle(s) {
        return norm(s).replace(/[^a-z0-9]/g, "");
      }

      function echapper(texte) {
        return (texte || "")
          .toString()
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;");
      }

      function afficherAlerte(message) {
        alerteScan.textContent = message;
        alerteScan.style.display = "block";
      }

      /* =========================================================
         CHARGEMENT
         ========================================================= */
      fetch("codes-sap.json")
        .then((r) => r.json())
        .then((d) => {
          CODES = d.codes || {};
        })
        .catch(() => {
          afficherAlerte("⚠️ Table des codes indisponible (codes-sap.json).");
        });

      PIGVS_COLISAGE.lireColisage()
        .then((d) => {
          COLISAGE = d || { conteneurs: [] };
        })
        .catch(() => {
          afficherAlerte("⚠️ Colisage indisponible (colisage-data.json).");
        });

      if (window.PIGVS) {
        PIGVS.loadChantiers();
      }

      /* =========================================================
         RECHERCHE DANS LE COLISAGE
         ========================================================= */
      function trouverCaisse(nom) {
        const recherche = cle(nom);
        if (!recherche) return null;

        /* 1er passage : correspondance exacte après normalisation */
        for (const conteneur of COLISAGE.conteneurs || []) {
          for (const caisse of conteneur.caisses || []) {
            if (cle(caisse.nom) === recherche) {
              return { conteneur, caisse };
            }
          }
        }

        /* 2e passage : l'un contient l'autre (BOX40 / BOX40A) */
        for (const conteneur of COLISAGE.conteneurs || []) {
          for (const caisse of conteneur.caisses || []) {
            const k = cle(caisse.nom);
            if (k && (k.includes(recherche) || recherche.includes(k))) {
              return { conteneur, caisse };
            }
          }
        }

        return null;
      }

      function trouverConteneur(nom) {
        const recherche = cle(nom);
        for (const conteneur of COLISAGE.conteneurs || []) {
          const k = cle(conteneur.nom);
          const r = cle(conteneur.ref || "");
          if (k === recherche || r === recherche) return conteneur;
        }
        for (const conteneur of COLISAGE.conteneurs || []) {
          const k = cle(conteneur.nom);
          if (k && (k.includes(recherche) || recherche.includes(k))) {
            return conteneur;
          }
        }
        return null;
      }

      function chercherCode(code) {
        const propre = code.trim();

        if (CODES[propre]) {
          return Object.assign({ code: propre }, CODES[propre]);
        }

        const k = Object.keys(CODES).find((x) => cle(x) === cle(propre));
        if (k) {
          return Object.assign({ code: propre }, CODES[k]);
        }

        /* Le code scanné est-il directement un nom de caisse ? */
        const caisse = trouverCaisse(propre);
        if (caisse) {
          return {
            code: propre,
            type: "caisse",
            cible: caisse.caisse.nom,
            libelle: caisse.caisse.nom,
          };
        }

        return null;
      }

      /* =========================================================
         SCANNER
         ========================================================= */
      const btnScan = document.getElementById("btnScan");

      if (typeof PIGVS_SCAN === "undefined") {
        btnScan.disabled = true;
        afficherAlerte(
          "❌ Module de scan non chargé. Vérifiez que pigvs-scan.js est bien en ligne."
        );
      } else if (!PIGVS_SCAN.disponible()) {
        btnScan.disabled = true;
        afficherAlerte(
          "ℹ️ Le scan par caméra nécessite Chrome sur Android, en HTTPS. Utilisez la saisie manuelle ci-dessous."
        );
      }

      btnScan.addEventListener("click", function () {
        if (typeof PIGVS_SCAN === "undefined") return;
        PIGVS_SCAN.ouvrir(traiterCode, afficherAlerte);
      });

      document
        .getElementById("btnValiderCode")
        .addEventListener("click", function () {
          const code = document.getElementById("codeManuel").value.trim();
          if (code) traiterCode(code);
        });

      document
        .getElementById("codeManuel")
        .addEventListener("keydown", function (e) {
          if (e.key === "Enter") {
            const code = e.target.value.trim();
            if (code) traiterCode(code);
          }
        });

      /* =========================================================
         AIGUILLAGE
         ========================================================= */
      function traiterCode(code) {
        alerteScan.style.display = "none";
        const trouve = chercherCode(code);

        if (!trouve) {
          zoneResultat.innerHTML =
            '<div class="resultat" style="--acc: var(--orange)">' +
            '<span class="type">Code inconnu</span>' +
            "<h3>Aucune correspondance</h3>" +
            '<div class="code-lu">' +
            echapper(code) +
            "</div>" +
            '<p style="font-size:14px;color:var(--muted);margin:0 0 14px">' +
            "Ce code n'est pas répertorié dans <b>codes-sap.json</b>." +
            "</p>" +
            '<div class="actions-resultat">' +
            '<a href="colisage-consultation.html"><span>🔍 Chercher dans le colisage</span><span class="fl">›</span></a>' +
            '<a href="colisage-saisie.html"><span>📝 Renseigner un colisage</span><span class="fl">›</span></a>' +
            "</div></div>";
          window.scrollTo(0, 0);
          return;
        }

        if (trouve.type === "caisse") return afficherCaisse(trouve);
        if (trouve.type === "conteneur") return afficherConteneur(trouve);
        return afficherEquipement(trouve);
      }

      /* ---------- CAISSE ---------- */
      function afficherCaisse(info) {
        const resultat = trouverCaisse(info.cible);
        let contenu = "";
        let lienConsulter = "";

        if (resultat) {
          const items = resultat.caisse.items || [];

          /* Le lien de consultation ouvre directement la caisse */
          lienConsulter =
            '<a class="principal" href="colisage-consultation.html?caisse=' +
            encodeURIComponent(resultat.caisse.nom) +
            '"><span>🔍 Consulter le colisage de cette caisse</span><span class="fl">›</span></a>';

          contenu =
            '<div class="bloc-contenu">' +
            '<div class="entete"><span>Contenu théorique</span>' +
            '<span class="compte">' +
            items.length +
            " élément(s)</span>" +
            "<span>· Conteneur : <b>" +
            echapper(resultat.conteneur.nom) +
            "</b></span></div>" +
            (items.length
              ? '<ul class="liste-contenu">' +
                items.map((i) => "<li>" + echapper(i) + "</li>").join("") +
                "</ul>"
              : '<p style="font-size:14px;color:var(--muted);margin:0">Cette caisse est référencée mais ne contient aucun élément.</p>') +
            "</div>";
        } else {
          lienConsulter =
            '<a class="principal" href="colisage-consultation.html"><span>🔍 Consulter le colisage</span><span class="fl">›</span></a>';

          contenu =
            '<div class="alerte-scan" style="display:block">' +
            "⚠️ Cette caisse n'a pas été trouvée dans <b>colisage-data.json</b>. " +
            "Vérifiez que le nom « " +
            echapper(info.cible) +
            " » correspond bien à une caisse du colisage." +
            "</div>";
        }

        zoneResultat.innerHTML =
          '<div class="resultat" style="--acc: var(--primary)">' +
          '<span class="type">🧰 Caisse</span>' +
          "<h3>" +
          echapper(info.cible) +
          "</h3>" +
          '<div class="code-lu">' +
          echapper(info.code) +
          "</div>" +
          '<div class="actions-resultat">' +
          lienConsulter +
          '<a href="colisage-saisie.html?caisse=' +
          encodeURIComponent(info.cible) +
          '"><span>📝 Renseigner le colisage de cette caisse</span><span class="fl">›</span></a>' +
          "</div>" +
          contenu +
          "</div>";
        window.scrollTo(0, 0);
      }

      /* ---------- CONTENEUR ---------- */
      function afficherConteneur(info) {
        const conteneur = trouverConteneur(info.cible);
        let resume = "";

        if (conteneur) {
          const nbCaisses = (conteneur.caisses || []).length;
          const nbItems = (conteneur.caisses || []).reduce(
            (s, k) => s + (k.items || []).length,
            0
          );
          resume =
            '<div class="bloc-contenu"><div class="entete">' +
            '<span class="compte">' +
            nbCaisses +
            " caisses</span>" +
            '<span class="compte">' +
            nbItems +
            " éléments</span>" +
            "</div></div>";
        }

        zoneResultat.innerHTML =
          '<div class="resultat" style="--acc: var(--orange)">' +
          '<span class="type">📦 Conteneur</span>' +
          "<h3>" +
          echapper(info.cible) +
          "</h3>" +
          '<div class="code-lu">' +
          echapper(info.code) +
          "</div>" +
          '<div class="actions-resultat">' +
          '<a class="principal" href="colisage-consultation.html?conteneur=' +
          encodeURIComponent(info.cible) +
          '"><span>🔍 Consulter le contenu du conteneur</span><span class="fl">›</span></a>' +
          '<a href="photo.html?type=calage-arrimage"><span>🔗 Photos de calage / arrimage</span><span class="fl">›</span></a>' +
          '<a href="photo.html?type=feuilles-colisage"><span>📄 Photos des feuilles de colisage</span><span class="fl">›</span></a>' +
          "</div>" +
          resume +
          "</div>";
        window.scrollTo(0, 0);
      }

      /* ---------- ÉQUIPEMENT ---------- */
      function afficherEquipement(info) {
        /* Où se trouve cet équipement dans le colisage ? */
        const recherche = cle(info.cible);
        let localisation = null;

        for (const conteneur of COLISAGE.conteneurs || []) {
          for (const caisse of conteneur.caisses || []) {
            for (const item of caisse.items || []) {
              if (cle(item) === recherche) {
                localisation = { conteneur, caisse, item };
                break;
              }
            }
            if (localisation) break;
          }
          if (localisation) break;
        }

        let blocLoc = "";
        let lienLoc =
          '<a href="colisage-consultation.html"><span>🔍 Localiser dans le colisage</span><span class="fl">›</span></a>';

        if (localisation) {
          blocLoc =
            '<div class="bloc-contenu"><div class="entete">' +
            "<span>📍 Localisé dans</span>" +
            '<span class="compte">' +
            echapper(localisation.caisse.nom) +
            "</span>" +
            "<span>· " +
            echapper(localisation.conteneur.nom) +
            "</span></div></div>";

          lienLoc =
            '<a class="principal" href="colisage-consultation.html?caisse=' +
            encodeURIComponent(localisation.caisse.nom) +
            '"><span>🔍 Voir la caisse ' +
            echapper(localisation.caisse.nom) +
            "</span><span class=\"fl\">›</span></a>";
        }

        zoneResultat.innerHTML =
          '<div class="resultat" style="--acc: var(--cyan)">' +
          '<span class="type">🔧 Équipement</span>' +
          "<h3>" +
          echapper(info.cible) +
          "</h3>" +
          '<div class="code-lu">' +
          echapper(info.code) +
          "</div>" +
          '<div class="actions-resultat">' +
          lienLoc +
          '<button type="button" class="indispo"><span>📊 État de l\'équipement — à venir</span><span class="fl">›</span></button>' +
          '<a href="fdm.html"><span>📋 Ouvrir une fiche de maintenance</span><span class="fl">›</span></a>' +
          "</div>" +
          blocLoc +
          "</div>";
        window.scrollTo(0, 0);
      }
</script>
  </body>
</html>
